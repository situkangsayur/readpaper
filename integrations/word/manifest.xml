<?xml version="1.0" encoding="UTF-8"?>
<!-- Add-in Word ReadPaper. Task pane disajikan dari GitHub Pages repositori
     ini; datanya diambil dari ReadPaper desktop di http://127.0.0.1:23121. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>d060c908-398d-486e-b5b4-7cc06fb48ff6</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ReadPaper</ProviderName>
  <DefaultLocale>id-ID</DefaultLocale>
  <DisplayName DefaultValue="ReadPaper">
    <Override Locale="en-US" Value="ReadPaper"/>
  </DisplayName>
  <Description DefaultValue="Sitasi dan daftar pustaka dari library ReadPaper di komputer ini.">
    <Override Locale="en-US" Value="Citations and bibliographies from the ReadPaper library on this computer."/>
  </Description>
  <IconUrl DefaultValue="https://situkangsayur.github.io/readpaper/word/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://situkangsayur.github.io/readpaper/word/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/situkangsayur/readpaper"/>
  <AppDomains>
    <AppDomain>https://situkangsayur.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://situkangsayur.github.io/readpaper/word/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabReferences">
              <Group id="ReadPaper.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="ReadPaper.TaskpaneButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ReadPaperTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://situkangsayur.github.io/readpaper/word/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://situkangsayur.github.io/readpaper/word/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://situkangsayur.github.io/readpaper/word/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/situkangsayur/readpaper/tree/main/integrations"/>
        <bt:Url id="Commands.Url" DefaultValue="https://situkangsayur.github.io/readpaper/word/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://situkangsayur.github.io/readpaper/word/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="ReadPaper siap dipakai">
          <bt:Override Locale="en-US" Value="ReadPaper is ready"/>
        </bt:String>
        <bt:String id="Group.Label" DefaultValue="ReadPaper"/>
        <bt:String id="Button.Label" DefaultValue="Sitasi ReadPaper">
          <bt:Override Locale="en-US" Value="ReadPaper citations"/>
        </bt:String>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Buka panel ReadPaper dari tab Referensi untuk menyisipkan sitasi.">
          <bt:Override Locale="en-US" Value="Open the ReadPaper pane from the References tab to insert citations."/>
        </bt:String>
        <bt:String id="Button.Tooltip" DefaultValue="Sisipkan sitasi dan daftar pustaka dari ReadPaper.">
          <bt:Override Locale="en-US" Value="Insert citations and bibliographies from ReadPaper."/>
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
